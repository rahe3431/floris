Function 36: //PromptAlyssa GiveFlower?
    Message 14
	WaitButton
    YesNoBox 0x800C //give flower? 
    CompareVarValue 0x800C 1 //giveflower
	JumpIf EQUAL Function#31
    CompareVarValue 0x800C 0 //dontgiveflower
	JumpIf EQUAL Function#33
	CloseMessage
	ReleaseAll
End

Function 37: //PromptAlyssa TellHomework?
	Message 50
	WaitButton
	CloseMessage
    YesNoBox 0x800C //tell homework? 
    CompareVarValue 0x800C 1 //tellHw
	JumpIf EQUAL Function#40
    CompareVarValue 0x800C 0 //dontTellHomework
	JumpIf EQUAL Function#38 
	ReleaseAll
End

Function 38: //DialogueAlyssa DontTellHomework
	Message 13
	WaitButton
	CloseMessage
	ReleaseAll
End

Function 39: //LogicAlyssa HasFlowerAlyssa check
	CompareVarValue 0x4001 1 //PossessFlower
	JumpIf EQUAL Function#36 //Prompt GiveFlower? function
	CompareVarValue 0x4001 0 //dontPossessFlower
    JumpIf EQUAL Function#33 //
End

Function 40: //LogicAlyssa KnowFutureAlyssa check
	CompareVarValue 0x4002 1 //KnowFuture
	JumpIf EQUAL Function#34//dialogue tellHomework KnowFuture function 
	CompareVarValue 0x4002 0 //dontKnow
    JumpIf EQUAL Function#35 //dialogue tellHomework DontKnowFuture function
End

//functions Alyssa

Function actionGiveFlowerAlyssa
    Assign HasFlowerAlyssa = 1
    Assign PossessFlower = 0
    Call logicCanGiveFlowerAlyssa
End

Function dialogueAlyssaAskTomorrow
    Output 13
End

Function dialogueAlyssaGiveFlower
    Output 15
End

Function dialogueAlyssaHomeworkStudy
    Output 9
End

Function dialogueAlyssaSaysNothing
End

Function dialogueAlyssaThankFlower
    Output 16
End

Function dialogueAlyssaThankHomework
    Output 12
End

Function dialogueAlyssaWrongHomework
    Output 11
End

Function dialogueMaxCouldHaveGoneBetter
    Output 49
End

Function dialogueMaxTellHomeworkDontKnowFuture
    Output 10
End

Function dialogueMaxTellHomeworkKnowFuture
    Output 8
End

Function logicCanGiveFlowerAlyssa
    If PossessFlower
        Call promptGiveFlowerAlyssa
    End
End

Function logicDoFlowerConvo
    If PossessFlower
        Call logicDoFlowerConvo
    Else
        Call logicHadConvoAlyssa
    End
End

Function logicHadConvoAlyssa
    If PossessFlower
    End
End

Function logicKnowFutureAlyssa
    Call dialogueAlyssaHomeworkStudy
    Call promptTellHomeworkAlyssa
    If YesNo
        If KnowFutureAlyssa
            Call dialogueMaxTellHomeworkKnowFuture
            Call dialogueAlyssaThankHomework
        Else
            Call dialogueMaxTellHomeworkDontKnowFuture
            Call dialogueAlyssaWrongHomework
            Assign KnowFutureAlyssa = 1
            Call dialogueCouldHaveGoneBetter
        End
    Else
        Call dialogueAlyssaAskTomorrow
        Call dialogueCouldHaveGoneBetter
    End
End

Function promptGiveFlowerAlyssa
    Assign YesNo = 0
    Output 14
    Input YesNo
    If 
        Call actionGiveFlowerAlyssa
    End
End

Function promptTellHomeworkAlyssa
    Assign YesNo = 0
    Input YesNo
    If 
        If KnowFutureAlyssa
            Call dialogueMaxTellHomeworkKnowFuture
            Call dialogueAlyssaThankHomework
        Else
            Call dialogueMaxTellHomeworkDontKnowFuture
            Call dialogueAlyssaWrongHomework
            Assign KnowFutureAlyssa = 1
            Call dialogueCouldHaveGoneBetter
        End
    Else
        Call dialogueAlyssaAskTomorrow
        Call dialogueCouldHaveGoneBetter
    End
End

