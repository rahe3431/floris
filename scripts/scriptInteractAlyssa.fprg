<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="scriptInteractAlyssa"/>
        <attribute name="authors" value="vvrea"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-02-27 01:19:00 PM"/>
        <attribute name="created" value="dnZyZWE7UkFDSEVMREVTS1RPUDsyMDI2LTAyLTI2OzAzOjEwOjU4IFBNOzI3OTg="/>
        <attribute name="edited" value="dnZyZWE7UkFDSEVMREVTS1RPUDsyMDI2LTAyLTI3OzAxOjE5OjAwIFBNOzUxOzI5NTQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <call expression="LockAll"/>
            <call expression="FacePlayer"/>
            <call expression="logicCanGiveFlowerAlyssa"/>
            <if expression="HadConvoAlyssa">
                <then>
                    <call expression="LogicWhichDialogueHadConvo"/>
                </then>
                <else>
                    <call expression="logicKnowFutureAlyssa"/>
                    <assign variable="HadConvo" expression="1"/>
                </else>
            </if>
            <call expression="ReleaseAll"/>
        </body>
    </function>
    <function name="actionGiveFlowerAlyssa" type="None" variable="">
        <parameters/>
        <body>
            <assign variable="HasFlowerAlyssa" expression="1"/>
            <assign variable="PossessFlower" expression="0"/>
            <call expression="dialogueAlyssaGiveFlower"/>
            <call expression="logicCanGiveFlowerAlyssa"/>
        </body>
    </function>
    <function name="dialogueAlyssaAskTomorrow" type="None" variable="">
        <parameters/>
        <body>
            <output expression="13" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueAlyssaGiveFlower" type="None" variable="">
        <parameters/>
        <body>
            <output expression="15" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueAlyssaHomeworkStudy" type="None" variable="">
        <parameters/>
        <body>
            <output expression="9" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueAlyssaSaysNothing" type="None" variable="">
        <parameters/>
        <body>
            <output expression="" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueAlyssaThankFlower" type="None" variable="">
        <parameters/>
        <body>
            <output expression="16" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueAlyssaThankHomework" type="None" variable="">
        <parameters/>
        <body>
            <output expression="12" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueAlyssaWrongHomework" type="None" variable="">
        <parameters/>
        <body>
            <output expression="11" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueMaxCouldHaveGoneBetter" type="None" variable="">
        <parameters/>
        <body>
            <output expression="49" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueMaxTellHomeworkDontKnowFuture" type="None" variable="">
        <parameters/>
        <body>
            <output expression="10" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="dialogueMaxTellHomeworkKnowFuture" type="None" variable="">
        <parameters/>
        <body>
            <output expression="8" newline="True"/>
            <call expression="CloseMessage"/>
        </body>
    </function>
    <function name="logicCanGiveFlowerAlyssa" type="None" variable="">
        <parameters/>
        <body>
            <if expression="PossessFlower">
                <then>
                    <call expression="promptGiveFlowerAlyssa"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
    <function name="logicDoFlowerConvo" type="None" variable="">
        <parameters/>
        <body>
            <if expression="PossessFlower">
                <then>
                    <call expression="logicDoFlowerConvo"/>
                </then>
                <else>
                    <call expression="logicHadConvoAlyssa"/>
                </else>
            </if>
        </body>
    </function>
    <function name="logicKnowFutureAlyssa" type="None" variable="">
        <parameters/>
        <body>
            <call expression="dialogueAlyssaHomeworkStudy"/>
            <call expression="promptTellHomeworkAlyssa"/>
            <if expression="YesNo">
                <then>
                    <call expression="LogicKnowFutureAlyssa"/>
                </then>
                <else>
                    <call expression="dialogueAlyssaAskTomorrow"/>
                    <call expression="dialogueCouldHaveGoneBetter"/>
                </else>
            </if>
        </body>
    </function>
    <function name="LogicTellHomeworkAlyssaKnowFuture" type="None" variable="">
        <parameters/>
        <body>
            <if expression="KnowFutureAlyssa">
                <then>
                    <call expression="dialogueMaxTellHomeworkKnowFuture"/>
                    <call expression="dialogueAlyssaThankHomework"/>
                </then>
                <else>
                    <call expression="dialogueMaxTellHomeworkDontKnowFuture"/>
                    <call expression="dialogueAlyssaWrongHomework"/>
                    <assign variable="KnowFutureAlyssa" expression="1"/>
                    <call expression="dialogueCouldHaveGoneBetter"/>
                </else>
            </if>
        </body>
    </function>
    <function name="logicWhichDialogueHadConvo" type="None" variable="">
        <parameters/>
        <body>
            <if expression="HasFlowerAlyssa">
                <then>
                    <call expression="dialogueAlyssaThankFlower"/>
                </then>
                <else>
                    <call expression="dialogueAlyssaSaysNothing"/>
                </else>
            </if>
        </body>
    </function>
    <function name="promptGiveFlowerAlyssa" type="None" variable="">
        <parameters/>
        <body>
            <assign variable="YesNo" expression="0"/>
            <output expression="14" newline="True"/>
            <input variable="YesNoBox"/>
            <call expression="CloseMessage"/>
            <if expression="YesNo">
                <then>
                    <call expression="actionGiveFlowerAlyssa"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
    <function name="promptTellHomeworkAlyssa" type="None" variable="">
        <parameters/>
        <body>
            <assign variable="YesNo" expression="0"/>
            <input variable="YesNo"/>
            <call expression="CloseMessage"/>
            <if expression="YesNo">
                <then>
                    <call expression="LogicTellHomeworkAlyssaKnowFuture"/>
                </then>
                <else>
                    <call expression="dialogueAlyssaAskTomorrow"/>
                    <call expression="dialogueCouldHaveGoneBetter"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
