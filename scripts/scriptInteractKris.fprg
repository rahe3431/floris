    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <if expression="PossessFlower">
                <then>
                    <call expression="promptGiveFlowerKris"/>
                </then>
                <else>
                    <output expression="34" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="promptGiveFlowerKris" type="None" variable="">
        <parameters/>
        <body>
            <assign variable="YesNo" expression="0"/>
            <output expression="33" newline="True"/>
            <input variable="YesNo"/>
            <if expression="YesNo">
                <then>
                    <output expression="34" newline="True"/>
                </then>
                <else>
                    <output expression="32" newline="True"/>
                </else>
            </if>
        </body>
    </function>
